PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/campus-chaos
# Replace with your MongoDB Atlas URI when ready:
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/campus-chaos?retryWrites=true&w=majority
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
# Cookie auth (httpOnly, JS cannot read token)
# COOKIE_NAME=cc_token
# COOKIE_SAMESITE=lax
# NODE_ENV=development
