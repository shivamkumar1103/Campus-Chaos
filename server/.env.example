# -----------------------------------------------------------------------------
# Campus Chaos Server Environment Configuration
# -----------------------------------------------------------------------------

# Port (Render automatically sets PORT=10000; defaults to 5000 locally)
PORT=5000

# Environment: 'development' or 'production'
NODE_ENV=development

# MongoDB Connection String:
# Local:
MONGO_URI=mongodb://127.0.0.1:27017/campus-chaos
# Production (MongoDB Atlas):
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/campus-chaos?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=replace_with_a_long_random_secret_key_in_production
JWT_EXPIRES_IN=7d

# Allowed Client Origin(s) for CORS & Email Links
# In production on Render, set to your Vercel URL (e.g. https://your-project.vercel.app)
# Comma-separated list is supported (e.g. https://your-project.vercel.app,http://localhost:5173)
CLIENT_URL=http://localhost:5173

# Cookie Settings
# 'lax' for local development (same domain)
# 'none' required in production for cross-site cookies (Vercel frontend -> Render backend)
COOKIE_SAMESITE=lax
COOKIE_NAME=cc_token

# Sender Email Address
EMAIL_FROM=noreply@campuschaos.edu

# Development SMTP (Mailtrap)
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USERNAME=your_mailtrap_username
EMAIL_PASSWORD=your_mailtrap_password

# Production SMTP (Brevo / Sendinblue)
BREVO_HOST=smtp-relay.brevo.com
BREVO_PORT=587
BREVO_USER=your_brevo_smtp_user
BREVO_PASS=your_brevo_smtp_key
