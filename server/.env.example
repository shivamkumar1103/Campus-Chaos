PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/campus-chaos
# Replace with your MongoDB Atlas URI when ready:
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/campus-chaos?retryWrites=true&w=majority
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
# Cookie auth (httpOnly, JS cannot read token)
# COOKIE_NAME=cc_token
# COOKIE_SAMESITE=lax
# NODE_ENV=development

# Sender Email Address
EMAIL_FROM=noreply@campuschaos.edu

# Development SMTP (Mailtrap)
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USERNAME=your_mailtrap_username
EMAIL_PASSWORD=your_mailtrap_password

# Production SMTP (Brevo)
BREVO_HOST=smtp-relay.brevo.com
BREVO_PORT=587
BREVO_USER=your_brevo_smtp_user
BREVO_PASS=your_brevo_smtp_key
